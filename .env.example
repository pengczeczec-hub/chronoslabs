# PayPal Live Client ID（公開，用於前端 PayPal 按鈕）
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_live_client_id

# PayPal Live Secret（僅伺服器端，不要加 NEXT_PUBLIC_）
PAYPAL_CLIENT_SECRET=your_live_secret

# 正式站網址
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# PayPal API 環境：live（正式）或 sandbox（測試）
PAYPAL_MODE=live

# 訂單通知信箱（商家收件）
ORDER_NOTIFICATION_EMAIL=your@email.com

# Resend 郵件服務（https://resend.com）
RESEND_API_KEY=re_xxxxxxxx
# 寄件人；未驗證網域時可用 onboarding@resend.dev（僅能寄到 Resend 帳號信箱）
RESEND_FROM_EMAIL=Chronos Labs <onboarding@resend.dev>
